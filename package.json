{
  "name": "hermes-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Capacitor shell for the Hermes Agent desktop renderer.",
  "engines": {
    "node": "^22.22.0 || ^24.11.0 || >=26.0.0",
    "npm": "<11.10.0 || >=11.17.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 0.0.0.0 --port 5175",
    "preview": "vite preview --host 127.0.0.1 --port 4175",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests vite.config.ts capacitor.config.ts --max-warnings=0",
    "test": "node --test tests/*.test.mjs",
    "test:webkit": "playwright test tests/webkit-smoke.spec.ts",
    "sync": "cap sync ios",
    "ios": "cap open ios",
    "bump-upstream": "bash scripts/bump-upstream.sh",
    "scan-bridge-usage": "node scripts/scan-bridge-usage.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.4.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "9.39.5",
    "globals": "17.7.0",
    "typescript": "6.0.3",
    "vite": "8.2.0"
  }
}
